generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  CLEANING
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum SessionStatus {
  ACTIVE
  FINISHED
  CANCELLED
}

enum PackageType {
  STANDARD
  DELUXE
}

enum KitchenStationType {
  DRINKS
  SUSHI
  HOT_KITCHEN
}

enum OrderStatus {
  PENDING
  PREPARING
  READY
  SERVED
  CANCELLED
}

enum UserRole {
  ADMIN
  STAFF
}

enum PromoDiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum PromoAppliesTo {
  ALL
  RESERVATION
  DINE_IN
  TAKEAWAY
  DELIVERY
}

model Table {
  id     String      @id @default(cuid())
  number Int         @unique
  seats  Int
  status TableStatus @default(AVAILABLE)

  selectedPackage  String?
  selectedGuests   Int?
  selectedPackages Json?

  label String?
  note  String?

  reservations Reservation[]
  sessions     TableSession[]
  orderLogs    TableOrderLog[]
  logs         TableLog[]
  payments     Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Reservation {
  id      String  @id @default(cuid())
  name    String
  phone   String
  email   String?
  message String?
  guests  Int

  startTime DateTime
  endTime   DateTime

  status ReservationStatus @default(PENDING)

  qrToken     String?   @unique
  checkedInAt DateTime?

  tableId String?
  table   Table?  @relation(fields: [tableId], references: [id])

  customerLinks CustomerReservation[]

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  promoCodeUsages PromoCodeUsage[]
}

model TableSession {
  id String @id @default(cuid())

  tableId String
  table   Table  @relation(fields: [tableId], references: [id])

  participants SessionParticipant[]
  orders       Order[]

  guests        Int
  packageType   PackageType
  startedAt     DateTime      @default(now())
  expiresAt     DateTime
  currentRound  Int           @default(1)
  cooldownUntil DateTime?
  status        SessionStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model KitchenStation {
  id String @id @default(cuid())

  name String             @unique
  type KitchenStationType

  items MenuItem[]

  printerIp      String?
  tickets        KitchenTicket[]
  receiptPrinter Boolean         @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MenuCategory {
  id String @id @default(cuid())

  name      String
  slug      String     @unique
  sortOrder Int        @default(0)
  items     MenuItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MenuItem {
  id String @id @default(cuid())

  name        String
  description String?
  price       Float?
  btwRate     Float       @default(9)
  orderItems  OrderItem[]
  image       String?
  isActive    Boolean     @default(true)
  isDelivery  Boolean     @default(false)

  categoryId String
  category   MenuCategory @relation(fields: [categoryId], references: [id])

  stationId String?
  station   KitchenStation? @relation(fields: [stationId], references: [id])

  packages PackageMenuItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Package {
  id String @id @default(cuid())

  name    String            @unique
  price   Float             @default(0)
  btwRate Float             @default(9)
  items   PackageMenuItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PackageMenuItem {
  id String @id @default(cuid())

  packageId  String
  menuItemId String

  package  Package  @relation(fields: [packageId], references: [id])
  menuItem MenuItem @relation(fields: [menuItemId], references: [id])

  createdAt DateTime @default(now())

  @@unique([packageId, menuItemId])
}

model SessionParticipant {
  id String @id @default(cuid())

  sessionId String
  session   TableSession @relation(fields: [sessionId], references: [id])
  name      String?
  joinedAt  DateTime     @default(now())
  orders    Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id String @id @default(cuid())

  sessionId String
  session   TableSession @relation(fields: [sessionId], references: [id])

  participantId String
  participant   SessionParticipant @relation(fields: [participantId], references: [id])

  roundNumber Int
  status      OrderStatus @default(PENDING)
  submittedAt DateTime    @default(now())
  items       OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OrderItem {
  id String @id @default(cuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id])

  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])

  quantity Int     @default(1)
  notes    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id String @id @default(cuid())

  email    String    @unique
  password String
  role     UserRole  @default(STAFF)
  sessions Session[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TableOrderLog {
  id String @id @default(cuid())

  tableId  String
  table    Table  @relation(fields: [tableId], references: [id])
  itemName String
  price    Float
  btwRate  Float  @default(9)

  createdAt DateTime @default(now())
}

model TableLog {
  id String @id @default(cuid())

  tableId    String
  table      Table   @relation(fields: [tableId], references: [id])
  type       String
  message    String
  beforeData Json?
  afterData  Json?
  undone     Boolean @default(false)

  createdAt DateTime @default(now())
}

model KitchenTicket {
  id String @id @default(cuid())

  tableId     String?
  tableNumber Int?
  itemName    String
  quantity    Int     @default(1)

  stationId String?
  station   KitchenStation? @relation(fields: [stationId], references: [id])

  printerName String?
  printed     Boolean @default(false)

  createdAt DateTime @default(now())
}

model Payment {
  id String @id @default(cuid())

  tableId     String
  table       Table  @relation(fields: [tableId], references: [id])
  tableNumber Int
  method      String
  total       Float
  paid        Float?
  change      Float?
  tip         Float  @default(0)
  discount    Float  @default(0)

  createdAt DateTime @default(now())
}

model Session {
  id String @id @default(cuid())

  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ip         String?
  userAgent  String?
  online     Boolean  @default(true)
  banned     Boolean  @default(false)
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
}

model BannedIp {
  id        String    @id @default(cuid())
  ip        String    @unique
  reason    String?
  expiresAt DateTime?
  createdAt DateTime  @default(now())
}

model BannedEmail {
  id        String    @id @default(cuid())
  email     String    @unique
  reason    String?
  expiresAt DateTime?
  createdAt DateTime  @default(now())
}

model TakeAwayCategory {
  id        String         @id @default(cuid())
  name      String
  sortOrder Int            @default(0)
  items     TakeAwayItem[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model TakeAwayItem {
  id       String  @id @default(cuid())
  name     String
  price    Float
  btwRate  Float   @default(9)
  isActive Boolean @default(true)

  categoryId String
  category   TakeAwayCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TakeAwayOrder {
  id          String              @id @default(cuid())
  orderNumber Int
  method      String
  total       Float
  paid        Float?
  change      Float?
  tip         Float               @default(0)
  items       TakeAwayOrderItem[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

model TakeAwayOrderItem {
  id String @id @default(cuid())

  orderId String
  order   TakeAwayOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  itemId   String?
  itemName String
  price    Float
  quantity Int     @default(1)
  btwRate  Float   @default(9)

  createdAt DateTime @default(now())
}

model SystemLog {
  id          String   @id @default(cuid())
  type        String
  level       String   @default("INFO")
  message     String
  tableId     String?
  tableNumber Int?
  userId      String?
  userEmail   String?
  ip          String?
  userAgent   String?
  beforeData  Json?
  afterData   Json?
  metadata    Json?
  createdAt   DateTime @default(now())
}

model Customer {
  id String @id @default(cuid())

  name     String
  email    String  @unique
  phone    String?
  password String

  role CustomerRole @default(CUSTOMER)

  isBlocked     Boolean   @default(false)
  blockedAt     DateTime?
  blockedReason String?

  deletedAt DateTime?

  mustChangePassword Boolean @default(false)

  sessions     CustomerSession[]
  reservations CustomerReservation[]

  adminActions CustomerAdminAuditLog[] @relation("AdminActor")

  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  createdPromoCodes PromoCode[]      @relation("PromoCodeCreatedBy")
  promoCodeUsages   PromoCodeUsage[]
}

model CustomerSession {
  id String @id @default(cuid())

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  token String @unique

  ip        String?
  userAgent String?

  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime?

  @@index([customerId])
}

model CustomerReservation {
  id String @id @default(cuid())

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  reservationId String
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([customerId, reservationId])
}

enum CustomerRole {
  CUSTOMER
  ADMIN
  OWNER
}

model CustomerAdminAuditLog {
  id String @id @default(cuid())

  actorId String
  actor   Customer @relation("AdminActor", fields: [actorId], references: [id], onDelete: Restrict)

  targetCustomerId String?

  action String

  beforeData Json?
  afterData  Json?

  ip        String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([targetCustomerId])
  @@index([createdAt])
}

model RestaurantSettings {
  id Int @id @default(1)

  restaurantOpen Boolean @default(true)

  closedMessage String @default("DaWu Sushi Fusion is temporarily closed. Reservations and online ordering are currently unavailable.")

  reservationStartTime String @default("16:00")
  reservationEndTime   String @default("22:00")
  reservationInterval  Int    @default(15)

  updatedAt DateTime @updatedAt
}

model PromoCode {
  id String @id @default(cuid())

  code        String  @unique
  name        String
  description String?

  discountType  PromoDiscountType
  discountValue Float

  maximumDiscount    Float?
  minimumOrderAmount Float?

  appliesTo PromoAppliesTo @default(ALL)

  startsAt  DateTime?
  expiresAt DateTime?

  usageLimit            Int?
  usageLimitPerCustomer Int  @default(1)
  usageCount            Int  @default(0)

  firstOrderOnly Boolean   @default(false)
  isActive       Boolean   @default(true)
  deletedAt      DateTime?

  createdById String
  createdBy   Customer @relation("PromoCodeCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  usages PromoCodeUsage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([expiresAt])
  @@index([deletedAt])
  @@index([createdById])
}

model PromoCodeUsage {
  id String @id @default(cuid())

  promoCodeId String
  promoCode   PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  reservationId String?
  reservation   Reservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)

  orderAmount    Float
  discountAmount Float

  email String?
  phone String?

  usedAt DateTime @default(now())

  @@index([promoCodeId])
  @@index([customerId])
  @@index([reservationId])
  @@index([email])
  @@index([phone])
  @@index([usedAt])
}
